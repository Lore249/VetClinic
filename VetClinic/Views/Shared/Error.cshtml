@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="h3 text-danger">Bir hata oluştu</h1>
    <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">İstek kimliği: <code>@Model.RequestId</code></p>
    }
</div>
