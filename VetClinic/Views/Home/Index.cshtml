@model HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var today = DateTime.Today.DayOfWeek;
}

<section class="kk-hero rounded-4 p-4 p-md-5 mb-4">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="display-5">Kerem'in Kliniği</h1>
            <p class="lead">
                Serdivan'da kedi, köpek, kuş ve tavşan dostlarımız için muayene, aşı ve bakım hizmetleri.
                Randevunuzu çevrim içi alın, hayvanlarınızın aşı takvimini tek yerden takip edin.
            </p>
            @* Ziyaretçi randevu için önce üye olur; giriş yapmış üye doğrudan randevu ekranına gider. *@
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Randevu Al</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">Giriş Yap</a>
            }
            else if (User.IsInRole(AppRoles.Member))
            {
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-lg me-2">Randevu Al</a>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary btn-lg">Randevularım</a>
            }
            else if (User.IsInRole(AppRoles.Veterinarian))
            {
                <a asp-controller="VeterinarianPanel" asp-action="Index" class="btn btn-primary btn-lg">Hekim Paneli</a>
            }
            else if (User.IsInRole(AppRoles.Admin))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg">Yönetim Paneli</a>
            }
        </div>
    </div>
</section>

<section class="row g-4">
    <div class="col-md-4">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Kolay randevu</h2>
                <p class="text-muted mb-0">Hizmeti ve tarihi seçin, hekimlerimizin boş saatlerini görüp size uygun olanı alın.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Aşı takvimi</h2>
                <p class="text-muted mb-0">Hayvanlarınıza yapılan ve yaklaşan aşıları tek ekranda görün, hiçbir dozu kaçırmayın.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Uzman hekimler</h2>
                <p class="text-muted mb-0">Farklı uzmanlık alanlarından veteriner hekimlerimiz dostlarınızı özenle muayene eder.</p>
            </div>
        </div>
    </div>
</section>

@* Hizmet kartları: yalnızca aktif hizmetler, süre ve ücretiyle (admin panelindeki Hizmetler sayfasından gelir). *@
<section class="mt-5">
    <h2 class="h3 mb-3">Hizmetlerimiz</h2>
    <div class="row g-4">
        @foreach (var service in Model.Services)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card kk-card h-100">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5">@service.Name</h3>
                        <p class="text-muted flex-grow-1">@service.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge kk-badge-light">@service.DurationMinutes dk</span>
                            <span class="kk-price">@service.Price.ToString("N2") ₺</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="row g-4 mt-4 mb-2">
    @* Çalışma saatleri tablosu: admin panelindeki Çalışma Saatleri sayfasından gelir; bugünün satırı vurgulanır. *@
    <div class="col-lg-7">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h4 mb-3">Çalışma Saatleri</h2>
                <table class="table mb-0">
                    <tbody>
                        @foreach (var hour in Model.WorkingHours)
                        {
                            var isToday = hour.DayOfWeek == today;
                            <tr class="@(isToday ? "kk-today" : "")">
                                <td>
                                    @EnumTexts.ToTurkish(hour.DayOfWeek)
                                    @if (isToday)
                                    {
                                        <span class="badge text-bg-primary ms-1">Bugün</span>
                                    }
                                </td>
                                <td class="text-end">@(hour.IsClosed ? "Kapalı" : hour.OpenTime.ToString("HH:mm") + " - " + hour.CloseTime.ToString("HH:mm"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h4 mb-3">İletişim</h2>
                @if (Model.Clinic != null)
                {
                    <p class="mb-1 fw-semibold">@Model.Clinic.Name</p>
                    <p class="mb-1">@Model.Clinic.Address</p>
                    <p class="mb-3">@Model.Clinic.Phone</p>
                }
                <p class="text-muted mb-0">Randevular, hekimlerimizin müsait olduğu saatlere çevrim içi alınır ve onaylandığında kesinleşir.</p>
            </div>
        </div>
    </div>
</section>
