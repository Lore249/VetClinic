@model int
@* Model, hata durum kodudur (404, 405...). Başkasına ait bir kaydın adresi de bilerek 404 verdiği için
   mesaj "yok ya da erişim izniniz yok" diye yazıldı; kaydın var olup olmadığı söylenmez. *@
@{
    ViewData["Title"] = Model == 404 ? "Sayfa Bulunamadı" : "İstek Tamamlanamadı";
}

<div class="text-center py-5">
    @if (Model == 404)
    {
        <h1 class="h3">Sayfa bulunamadı</h1>
        <p class="text-muted">Aradığınız sayfa ya da kayıt yok veya bu kayda erişim izniniz yok.</p>
    }
    else
    {
        <h1 class="h3">İstek tamamlanamadı</h1>
        <p class="text-muted">Sunucu isteği işleyemedi (hata kodu: @Model).</p>
    }

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Ana Sayfaya Dön</a>
</div>
