@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Randevu Detayı";
    var appointment = Model.Appointment;
}

<h1 class="h3 mb-3">Randevu Detayı</h1>

@* Servisin kural ihlali mesajları (ör. "Başlangıç saati gelmemiş randevu tamamlanamaz.") burada görünür. *@
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<partial name="_AppointmentInfo" model="appointment" />

@* Düğmeler yalnızca uygun durumda gösterilir; bu bir kolaylıktır. Asıl kural her istekte serviste yeniden kontrol edilir. *@
@if (appointment.Status == AppointmentStatus.Pending)
{
    <div class="card kk-card mb-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Onayla ya da reddet</h2>
            <form asp-action="Approve" asp-route-id="@appointment.Id" method="post" class="mb-4">
                <button type="submit" class="btn btn-primary">Onayla</button>
            </form>
            <partial name="_RejectAppointmentForm" model="new RejectAppointmentViewModel { AppointmentId = appointment.Id }" />
        </div>
    </div>
}

@if (Model.CanComplete)
{
    <div class="card kk-card mb-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Muayeneyi tamamla</h2>
            <partial name="_CompleteForm" model="new CompleteAppointmentViewModel { AppointmentId = appointment.Id }" />
        </div>
    </div>
}
else if (appointment.Status == AppointmentStatus.Approved)
{
    <div class="alert alert-info">Randevu onaylı. Başlangıç saati geldiğinde muayene notunu girerek tamamlayabilirsiniz.</div>
}

<a asp-action="Index">&larr; Hekim Paneli</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
