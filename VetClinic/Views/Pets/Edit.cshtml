@model PetFormViewModel
@{
    ViewData["Title"] = "Hayvanı Düzenle";
}

<h1 class="h3 mb-3">Hayvanı Düzenle</h1>

<div class="card kk-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* Hangi kaydın güncelleneceği gizli alanla gönderilir; controller ve servis bu kaydın kullanıcıya ait olduğunu ayrıca kontrol eder. *@
            <input type="hidden" asp-for="Id" />

            <partial name="_PetFields" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
