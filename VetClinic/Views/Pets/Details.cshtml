@model Pet
@{
    ViewData["Title"] = Model.Name;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card kk-card">
            @if (Model.PhotoPath != null)
            {
                <img src="@Model.PhotoPath" alt="@Model.Name" class="kk-pet-photo" />
            }
            else
            {
                <div class="kk-pet-photo kk-pet-placeholder">@Model.Name.Substring(0, 1).ToUpper()</div>
            }
            <div class="card-body">
                <h1 class="h4 mb-3">@Model.Name</h1>
                <dl class="row mb-0">
                    <dt class="col-5">Tür</dt>
                    <dd class="col-7">@EnumTexts.ToTurkish(Model.Species)</dd>
                    <dt class="col-5">Irk</dt>
                    <dd class="col-7">@Model.Breed</dd>
                    <dt class="col-5">Doğum tarihi</dt>
                    <dd class="col-7">@Model.BirthDate.ToString("dd.MM.yyyy")</dd>
                    <dt class="col-5">Kilo</dt>
                    <dd class="col-7 mb-0">@Model.WeightKg.ToString("0.##") kg</dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-0 pt-0 pb-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Sil</a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card kk-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Aşı Kayıtları</h2>
                    <a asp-controller="Vaccinations" asp-action="Create" asp-route-petId="@Model.Id" class="btn btn-primary btn-sm">Aşı Ekle</a>
                </div>

                @if (Model.VaccinationRecords.Count == 0)
                {
                    <p class="text-muted mb-0">Henüz aşı kaydı yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Aşı</th>
                                    <th>Yapıldığı tarih</th>
                                    <th>Sonraki doz</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* En son yapılan aşı en üstte. *@
                                @foreach (var record in Model.VaccinationRecords.OrderByDescending(r => r.AdministeredOn))
                                {
                                    <tr>
                                        <td>@record.VaccineName</td>
                                        <td>@record.AdministeredOn.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (record.NextDoseOn == null)
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                <span>@record.NextDoseOn.Value.ToString("dd.MM.yyyy")</span>
                                                @* Tarihi geçmiş ama yapılmamış doz *@
                                                @if (record.NextDoseOn < today)
                                                {
                                                    <span class="badge text-bg-danger ms-1">Gecikmiş</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Vaccinations" asp-action="Edit" asp-route-id="@record.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                                            <a asp-controller="Vaccinations" asp-action="Delete" asp-route-id="@record.Id" class="btn btn-outline-danger btn-sm">Sil</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<p class="mt-3"><a asp-action="Index">&larr; Hayvanlarım</a></p>
