@model AppointmentCreateViewModel
@* Boş saatler listesi. Saatler sunucuda IAppointmentService.GetAvailableSlotsAsync ile hesaplanır.
   Her saat, çevreleyen POST formunun bir gönder düğmesidir. formaction özniteliği formu, hekimi ve saati sorgu dizesinde
   taşıyan adrese gönderir; hayvan ve hizmet formdaki gizli alanlardan gelir. Böylece JavaScript gerekmez. *@

@if (Model.Slots == null || Model.Slots.Count == 0)
{
    <div class="alert alert-info mb-0">
        Bu tarihte uygun saat yok: klinik kapalı olabilir, hizmeti veren hekimler o gün çalışmıyor olabilir,
        saatler dolu olabilir ya da tarih geçmiş olabilir. Başka bir tarih deneyin.
    </div>
}
else
{
    foreach (var slot in Model.Slots)
    {
        <div class="card kk-card mb-3">
            <div class="card-body">
                <h3 class="h6 mb-3">@slot.VeterinarianName</h3>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var time in slot.StartTimes)
                    {
                        var startTime = Model.Date!.Value.ToDateTime(time).ToString("yyyy-MM-ddTHH:mm");
                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                formaction="@Url.Action("Create", new { veterinarianId = slot.VeterinarianId, startTime = startTime })">
                            @time.ToString("HH:mm")
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}
