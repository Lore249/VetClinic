@model AppointmentCreateViewModel
@{
    ViewData["Title"] = "Randevu Al";
}

<h1 class="h3 mb-1">Randevu Al</h1>
<p class="text-muted mb-3">
    Hayvanı, hizmeti, hekimi ve başlangıç saatini seçin. Uygun saatleri görmek için <a asp-action="Slots">Boş Saatler</a> sayfasını kullanabilirsiniz.
    Randevu "Bekliyor" durumunda oluşur; hekim ya da yönetici onaylar.
</p>

<div class="card kk-card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @* Servisin kural ihlali ve çakışma mesajları burada görünür. *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="PetId" class="form-label"></label>
                    <select asp-for="PetId" class="form-select">
                        <option value="">Seçin</option>
                        @foreach (var pet in Model.PetOptions)
                        {
                            <option value="@pet.Id">@pet.Name (@EnumTexts.ToTurkish(pet.Species))</option>
                        }
                    </select>
                    <span asp-validation-for="PetId" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="ServiceId" class="form-label"></label>
                    <select asp-for="ServiceId" class="form-select">
                        <option value="">Seçin</option>
                        @foreach (var service in Model.ServiceOptions)
                        {
                            <option value="@service.Id">@service.Name (@service.DurationMinutes dk, @service.Price.ToString("N2") ₺)@(service.IsActive ? "" : " - pasif")</option>
                        }
                    </select>
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="VeterinarianId" class="form-label"></label>
                    <select asp-for="VeterinarianId" class="form-select">
                        <option value="">Seçin</option>
                        @foreach (var veterinarian in Model.VeterinarianOptions)
                        {
                            @* Hekimin verdiği hizmetler de yazılır: "hekim bu hizmeti vermiyor" kuralı denenebilsin. *@
                            <option value="@veterinarian.Id">@veterinarian.Title @veterinarian.User.FullName (@string.Join(", ", veterinarian.Services.Select(s => s.Name)))</option>
                        }
                    </select>
                    <span asp-validation-for="VeterinarianId" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="StartTime" class="form-label"></label>
                    @* datetime-local kutusu değeri 2026-11-23T09:00 biçiminde bekler ve gönderir; saniye gösterilmesin diye biçim verildi. *@
                    <input asp-for="StartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Randevu Oluştur</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
