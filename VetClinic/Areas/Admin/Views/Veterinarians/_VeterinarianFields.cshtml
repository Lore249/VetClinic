@model VeterinarianFormViewModel
@* Ekleme ve düzenleme formlarının ortak alanları. Ekleme sayfası VeterinarianCreateViewModel gönderir;
   o da VeterinarianFormViewModel'den türediği için bu partial'a verilebilir. *@

<div class="row">
    <div class="col-sm-4 mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Vet. Hek." />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-sm-8 mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
</div>

@* Onay kutuları elle yazıldı: hepsi aynı name'i (SelectedSpecialtyIds) taşır, işaretlenenlerin value'ları
   (id'ler) model binding ile List<int>'e dolar. checked="@true/false" yazımında Razor false ise özniteliği hiç yazmaz. *@
<fieldset class="mb-3">
    <legend class="form-label fs-6 fw-semibold">Uzmanlık alanları</legend>
    @if (Model.SpecialtyOptions.Count == 0)
    {
        <p class="text-muted small mb-0">Henüz uzmanlık tanımlanmamış.</p>
    }
    @foreach (var specialty in Model.SpecialtyOptions)
    {
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="SelectedSpecialtyIds" value="@specialty.Id"
                   id="specialty-@specialty.Id" checked="@Model.SelectedSpecialtyIds.Contains(specialty.Id)" />
            <label class="form-check-label" for="specialty-@specialty.Id">@specialty.Name</label>
        </div>
    }
</fieldset>

<fieldset class="mb-3">
    <legend class="form-label fs-6 fw-semibold">Verebildiği hizmetler</legend>
    @foreach (var service in Model.ServiceOptions)
    {
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="SelectedServiceIds" value="@service.Id"
                   id="service-@service.Id" checked="@Model.SelectedServiceIds.Contains(service.Id)" />
            <label class="form-check-label" for="service-@service.Id">
                @service.Name
                @if (!service.IsActive)
                {
                    <span class="text-muted small">(pasif)</span>
                }
            </label>
        </div>
    }
</fieldset>
