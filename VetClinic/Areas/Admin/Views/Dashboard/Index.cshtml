@{
    ViewData["Title"] = "Yönetim Paneli";
}

<h1 class="h3 mb-1">Yönetim Paneli</h1>
<p class="text-muted mb-4">Kliniğin bilgilerini, çalışma saatlerini, uzmanlık alanlarını, hizmetlerini ve veterinerlerini buradan yönetebilirsiniz.</p>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Klinik Bilgileri</h2>
                <p class="text-muted">Klinik adı, adresi ve telefonu.</p>
                <a asp-controller="Clinic" asp-action="Edit" class="btn btn-outline-primary btn-sm stretched-link">Düzenle</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Çalışma Saatleri</h2>
                <p class="text-muted">Haftanın her günü için açılış ve kapanış saatleri ya da kapalı gün.</p>
                <a asp-controller="Clinic" asp-action="WorkingHours" class="btn btn-outline-primary btn-sm stretched-link">Düzenle</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Uzmanlıklar</h2>
                <p class="text-muted">Hekimlere atanabilecek uzmanlık alanları.</p>
                <a asp-controller="Specialties" asp-action="Index" class="btn btn-outline-primary btn-sm stretched-link">Yönet</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Hizmetler</h2>
                <p class="text-muted">Muayene, aşı gibi hizmetlerin süresi, ücreti ve durumu.</p>
                <a asp-controller="Services" asp-action="Index" class="btn btn-outline-primary btn-sm stretched-link">Yönet</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card kk-card h-100">
            <div class="card-body">
                <h2 class="h5">Veterinerler</h2>
                <p class="text-muted">Hekimlerin giriş hesapları, uzmanlıkları, verdikleri hizmetler ve müsaitlik saatleri.</p>
                <a asp-controller="Veterinarians" asp-action="Index" class="btn btn-outline-primary btn-sm stretched-link">Yönet</a>
            </div>
        </div>
    </div>
</div>
