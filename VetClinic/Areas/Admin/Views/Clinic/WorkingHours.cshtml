@model WorkingHoursViewModel
@{
    ViewData["Title"] = "Çalışma Saatleri";
}

<h1 class="h3 mb-1">Çalışma Saatleri</h1>
<p class="text-muted mb-3">Randevular yalnızca kliniğin açık olduğu saatlere alınabilir. Kapalı işaretlenen günün saatleri dikkate alınmaz.</p>

<div class="card kk-card">
    <div class="card-body p-4">
        <form asp-action="WorkingHours" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Gün</th>
                            <th class="text-center">Kapalı</th>
                            <th>Açılış</th>
                            <th>Kapanış</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* foreach yerine for: alan adları Days[0].OpenTime, Days[1].OpenTime... olarak üretilsin
                           ve POST'ta model binding listeyi aynı sırayla doldurabilsin. *@
                        @for (var i = 0; i < Model.Days.Count; i++)
                        {
                            var dayName = EnumTexts.ToTurkish(Model.Days[i].DayOfWeek);
                            <tr>
                                <td class="fw-semibold">
                                    @dayName
                                    <input type="hidden" asp-for="Days[i].DayOfWeek" />
                                </td>
                                <td class="text-center">
                                    <input asp-for="Days[i].IsClosed" class="form-check-input" aria-label="@dayName kapalı" />
                                </td>
                                <td>
                                    @* Tag helper TimeOnly için kendiliğinden type="time" üretmez (düz metin kutusu çıkar);
                                       saat seçici görünsün diye tür açıkça yazıldı. Biçim, tarayıcının beklediği 09:00 şeklidir. *@
                                    <input asp-for="Days[i].OpenTime" type="time" asp-format="{0:HH:mm}" class="form-control" aria-label="@dayName açılış" />
                                    <span asp-validation-for="Days[i].OpenTime" class="text-danger small"></span>
                                </td>
                                <td>
                                    <input asp-for="Days[i].CloseTime" type="time" asp-format="{0:HH:mm}" class="form-control" aria-label="@dayName kapanış" />
                                    <span asp-validation-for="Days[i].CloseTime" class="text-danger small"></span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
