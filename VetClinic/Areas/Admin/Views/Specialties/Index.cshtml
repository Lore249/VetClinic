@model List<Specialty>
@{
    ViewData["Title"] = "Uzmanlıklar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Uzmanlıklar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Uzmanlık</a>
</div>

<div class="card kk-card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Henüz uzmanlık eklenmemiş.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Uzmanlık</th>
                            <th>Hekim sayısı</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var specialty in Model)
                        {
                            <tr>
                                <td>@specialty.Name</td>
                                <td>@specialty.Veterinarians.Count</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@specialty.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                                    <a asp-action="Delete" asp-route-id="@specialty.Id" class="btn btn-outline-danger btn-sm">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
