@model ServiceFormViewModel
@{
    ViewData["Title"] = "Hizmeti Düzenle";
}

<h1 class="h3 mb-1">Hizmeti Düzenle</h1>
<p class="text-muted mb-3">Süre ve ücret değişikliği yalnızca yeni randevuları etkiler; alınmış randevular kendi süre ve ücretini saklar.</p>

<div class="card kk-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* Hangi kaydın güncelleneceği gizli alanla geri gönderilir. *@
            <input type="hidden" asp-for="Id" />

            <partial name="_ServiceFields" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
